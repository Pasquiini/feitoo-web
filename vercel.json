{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/feitoo-web/browser",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "X-Frame-Options": "DENY",
        "Content-Security-Policy": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
      },
      "continue": true
    },
    {
      "src": "/index.html",
      "headers": {
        "Location": "/"
      },
      "status": 308
    },
    {
      "src": "/(gerador-de-orcamentos|docx-para-pdf|xml-para-excel|xml-para-pdf|organizar-xml|analisar-xml|produtos-dos-xmls|planos|seguranca|privacidade|termos|como-converter-xml-nfe-para-excel|como-extrair-produtos-de-xml-nfe)/index.html",
      "headers": {
        "Location": "/$1"
      },
      "status": 308
    },
    {
      "src": "/gerador-de-orcamentos/?",
      "headers": { "X-Robots-Tag": "noindex, follow" },
      "continue": true
    },
    {
      "src": "/(?:conta|login|cadastro)/?",
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      },
      "continue": true
    },
    {
      "src": "/404(?:/index.html|/|\\.html)?",
      "headers": {
        "X-Robots-Tag": "noindex, follow"
      },
      "continue": true
    },
    {
      "src": "/(gerador-de-orcamentos|docx-para-pdf|xml-para-excel|xml-para-pdf|organizar-xml|analisar-xml|produtos-dos-xmls|planos|seguranca|privacidade|termos|como-converter-xml-nfe-para-excel|como-extrair-produtos-de-xml-nfe)/",
      "headers": {
        "Location": "/$1"
      },
      "status": 308
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(?:conta|login|cadastro)/?",
      "dest": "/index.csr.html"
    },
    {
      "src": "/.*",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
